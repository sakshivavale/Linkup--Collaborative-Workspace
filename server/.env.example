# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Port for the Express + Socket.IO server
PORT=3001

# Allowed CORS origin (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Supabase project URL (no trailing slash)
SUPABASE_URL=

# Supabase service role key — KEEP SECRET, never expose to browser
# Used for privileged server-side Supabase operations (token verification, DB access)
SUPABASE_SERVICE_ROLE_KEY=
