# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Port for the Express + Socket.IO server
PORT=3001

# Allowed CORS origin (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Supabase project URL (no trailing slash)
SUPABASE_URL=

# Supabase service role key — KEEP SECRET, never expose to browser
# Used for privileged server-side Supabase operations (token verification, DB access)
SUPABASE_SERVICE_ROLE_KEY=

# Piston code execution API URL (defaults to Public Piston https://emkc.org/api/v2/piston for local dev without Docker, or http://localhost:2000 if running Docker)
PISTON_URL=https://emkc.org/api/v2/piston
PISTON_API_URL=https://emkc.org/api/v2/piston
# Optional Piston API key if using an authenticated Piston instance
# PISTON_API_KEY=

# Optional Judge0 CE fallback execution API (via RapidAPI or self-hosted)
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=

# LiveKit SFU URL (defaults to wss://mock-livekit.local if omitted)
LIVEKIT_URL=wss://mock-livekit.local

# LiveKit API credentials (optional for mock/local development)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
