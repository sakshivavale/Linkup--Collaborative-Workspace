# ─── Client Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All variables MUST be prefixed with VITE_ to be exposed to the browser.

# Supabase project URL (no trailing slash)
VITE_SUPABASE_URL=

# Supabase anonymous/public key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=

# Backend API base URL (VITE_API_BASE_URL or VITE_API_URL)
VITE_API_BASE_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001

# Frontend App URL (for Supabase auth redirect URLs, reset password flow)
VITE_APP_URL=http://localhost:5173
