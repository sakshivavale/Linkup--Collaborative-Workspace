{
  "name": "@linkup/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean:src": "node -e \"const fs=require('fs'),p=require('path'); if(fs.existsSync('src')) fs.readdirSync('src').filter(f=>/\\.(js|d\\.ts|js\\.map)$/.test(f)).forEach(f=>fs.unlinkSync(p.join('src',f)))\"",
    "build": "npm run clean:src && tsc"
  }
}
