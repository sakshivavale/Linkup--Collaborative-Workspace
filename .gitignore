# Dependencies
node_modules/
.pnpm-store/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
client/.env
client/.env.local
server/.env
server/.env.local
# Allow .env.example files to be committed (they contain no secrets)
!**/.env.example

# Build outputs
dist/
build/
*.tsbuildinfo
shared/src/**/*.js
shared/src/**/*.d.ts
shared/src/**/*.js.map

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
