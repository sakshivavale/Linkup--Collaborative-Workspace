{
  "name": "linkup",
  "version": "0.1.0",
  "private": true,
  "description": "LinkUp — Collaborative Classroom Workspace",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:all": "npm-run-all --parallel dev dev:server",
    "build": "npm run build --workspace=client",
    "test:auth": "npm run test:auth --workspace=server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "socket.io-client": "^4.8.4"
  }
}
