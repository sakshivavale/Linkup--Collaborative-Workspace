{
  "name": "linkup",
  "version": "0.1.0",
  "private": true,
  "description": "LinkUp — Collaborative Classroom Workspace",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "test:auth": "npm run test:auth --workspace=server",
    "test:profile": "npm run test:profile --workspace=server",
    "test:rooms": "npm run test:rooms --workspace=server",
    "test:dash": "npm run test:dash --workspace=server",
    "test:create-room": "npm run test:create-room --workspace=server",
    "test:regenerate": "npm run test:regenerate --workspace=server",
    "test:member-removal": "npm run test:member-removal --workspace=server",
    "test:session": "npm run test:session --workspace=server",
    "test:screen-share": "npm run test:screen-share --workspace=server",
    "test:end-session": "npm run test:end-session --workspace=server",
    "test:host-leave": "npm run test:host-leave --workspace=server",
    "test:devices": "npm run test:devices --workspace=server",
    "test:chat-history": "npm run test:chat-history --workspace=server",
    "test:chat-send": "npm run test:chat-send --workspace=server"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "socket.io-client": "^4.8.4"
  }
}