{
  "name": "linkup",
  "version": "0.1.0",
  "private": true,
  "description": "LinkUp — Collaborative Classroom Workspace",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "test:auth": "npm run test:auth --workspace=server",
    "test:profile": "npm run test:profile --workspace=server",
    "test:rooms": "npm run test:rooms --workspace=server",
    "test:dash": "npm run test:dash --workspace=server",
    "test:create-room": "npm run test:create-room --workspace=server",
    "test:regenerate": "npm run test:regenerate --workspace=server",
    "test:member-removal": "npm run test:member-removal --workspace=server",
    "test:session": "npm run test:session --workspace=server",
    "test:screen-share": "npm run test:screen-share --workspace=server",
    "test:end-session": "npm run test:end-session --workspace=server",
    "test:host-leave": "npm run test:host-leave --workspace=server",
    "test:devices": "npm run test:devices --workspace=server",
    "test:chat-history": "npm run test:chat-history --workspace=server",
    "test:chat-send": "npm run test:chat-send --workspace=server",
    "test:chat-sender": "npm run test:chat-sender --workspace=server",
    "test:chat-links": "npm run test:chat-links --workspace=server",
    "test:permissions": "npm run test:permissions --workspace=server",
    "test:participant-permissions": "npm run test:participant-permissions --workspace=server",
    "test:perm-toast": "npm run test:perm-toast --workspace=server",
    "test:mute-all": "npm run test:mute-all --workspace=server",
    "test:code-editor": "npm run test:code-editor --workspace=server",
    "test:code-give-pen": "npm run test:code-give-pen --workspace=server",
    "test:code-sync": "npm run test:code-sync --workspace=server",
    "test:code-run": "npm run test:code-run --workspace=server",
    "test:wb-view": "npm run test:wb-view --workspace=server",
    "test:wb-draw": "npm run test:wb-draw --workspace=server",
    "test:wb-persist": "npm run test:wb-persist --workspace=server",
    "test:wb-live": "npm run test:wb-live --workspace=server",
    "test:wb-clear": "npm run test:wb-clear --workspace=server",
    "test:attendance": "npm run test:attendance --workspace=server",
    "test:attendance-grace": "npm run test:attendance-grace --workspace=server"
